---
interface Props { title?: string; description?: string; canonical?: string; image?: string; }
const { title = 'ORBITAL NOTES / 개인 기록 보관소', description = '생각과 관측을 천천히 기록하는 개인 블로그.', canonical, image = '/space-map.svg' } = Astro.props;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
---
<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} /><link rel="canonical" href={canonicalUrl} /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={new URL(image, Astro.url.origin).toString()} /><meta name="twitter:card" content="summary_large_image" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-noise" aria-hidden="true"></div>
		<header class="site-header shell">
			<a class="brand" href="/" aria-label="Orbital Notes home"><span class="brand-mark">✦</span><span>ORBITAL NOTES</span></a>
			<nav aria-label="주요 메뉴"><a href="/blog/">blog</a><a href="/#about">about</a><a href="/admin/">write</a></nav>
			<span class="status"><span class="status-dot"></span>signal stable</span>
		</header>
		<main><slot /></main>
		<footer class="site-footer shell"><span>ORBITAL NOTES</span><span>private log / 2026</span></footer>
	</body>
</html>
<style is:global>
	:root { --ink:#e9efff; --muted:#8793b2; --faint:#4e5a78; --void:#080a16; --line:rgba(152,168,220,.18); --violet:#a79bff; --cyan:#62dce8; --amber:#efbb75; font-family:'Space Grotesk',sans-serif; color:var(--ink); background:var(--void); font-synthesis:none; }
	* { box-sizing:border-box; } body { margin:0; min-width:320px; background:radial-gradient(circle at 70% 4%,#171b38 0,var(--void) 35rem); } a { color:inherit; text-decoration:none; }
	.shell { width:min(1120px,calc(100% - 48px)); margin:0 auto; } .site-noise { position:fixed; inset:0; pointer-events:none; opacity:.2; background-image:url('/space-map.svg'); background-size:900px; mix-blend-mode:screen; }
	.site-header { position:relative; z-index:2; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:24px; padding:28px 0; border-bottom:1px solid var(--line); }.brand { display:inline-flex; align-items:center; gap:11px; font-size:.72rem; letter-spacing:.14em; font-weight:600; }.brand-mark { color:var(--cyan); font-size:1.4rem; line-height:1; } nav { display:flex; gap:28px; font:.7rem 'DM Mono',monospace; color:var(--muted); } nav a:hover { color:var(--ink); }.status { justify-self:end; color:var(--muted); font:.65rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.08em; }.status-dot { display:inline-block; width:7px; height:7px; margin-right:7px; border-radius:50%; background:var(--cyan); box-shadow:0 0 13px var(--cyan); }.site-footer { display:flex; justify-content:space-between; padding:44px 0 34px; color:var(--faint); font:.65rem 'DM Mono',monospace; letter-spacing:.08em; text-transform:uppercase; }
	@media(max-width:620px) { .shell { width:min(100% - 32px,1120px); }.site-header { grid-template-columns:1fr auto; }.site-header nav { grid-column:1/-1; grid-row:2; order:3; }.status { display:none; } }
</style>
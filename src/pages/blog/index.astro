---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicCategories, getPublishedPosts } from '../../lib/server/content';

const categories = getPublicCategories();
const posts = getPublishedPosts();
const categoryParam = Astro.url.searchParams.get('category') ?? 'all';
const tagParam = Astro.url.searchParams.get('tag') ?? '';
const activeCategory = categoryParam === 'all' ? null : categories.find((category) => category.slug === categoryParam);
const filteredPosts = categoryParam !== 'all' && !activeCategory ? [] : activeCategory ? posts.filter((post) => post.category === activeCategory.slug) : tagParam ? posts.filter((post) => post.tags.includes(tagParam)) : posts;
const activeLabel = activeCategory?.name ?? (tagParam ? `#${tagParam}` : 'all transmissions');
---

<BaseLayout title="BLOG / ORBITAL NOTES" description="발행된 기록을 카테고리와 검색으로 탐색하는 Orbital Notes 블로그 아카이브.">
	<section class="archive-hero shell">
		<div>
			<p class="eyebrow"><span>02</span> transmission archive</p>
			<h1>모든 기록은<br /><em>여기서 궤도를 만납니다.</em></h1>
			<p class="archive-intro">관측과 개발, 생각의 조각을 한 곳에 모았습니다.<br />관심 있는 좌표를 골라 천천히 둘러보세요.</p>
		</div>
		<div class="archive-count"><strong>{filteredPosts.length.toString().padStart(2, '0')}</strong><span>published<br />signals</span></div>
	</section>

	<section class="archive shell" aria-labelledby="archive-heading">
		<div class="archive-toolbar">
			<div>
				<p class="eyebrow"><span>03</span> choose a coordinate</p>
				<h2 id="archive-heading">글 보관소</h2>
			</div>
			<label class="search-box">
				<span>⌕</span>
				<span class="sr-only">글 검색</span>
				<input id="post-search" type="search" placeholder="기록 검색" autocomplete="off" />
			</label>
		</div>

		<nav class="category-switcher" aria-label="글 카테고리">
			<a href="/blog/" data-category="all"><span>00</span>전체 기록</a>
			{categories.map((category, index) => <a class={category.accent} href={`/blog/?category=${category.slug}`} data-category={category.slug}><span>0{index + 1}</span>{category.name}</a>)}
		</nav>

		<div class="active-filter"><span class="filter-dot"></span><span id="active-label">{activeLabel}</span><span class="filter-rule"></span><span>{posts.length} total</span></div>

		<div class="post-grid" id="post-grid">
			{filteredPosts.map((post, index) => {
				const category = categories.find((item) => item.slug === post.category);
				return <a class="post-card" data-post-card data-category={post.category} data-search={`${post.title} ${post.excerpt} ${post.content.join(' ')} ${category?.name ?? ''} ${post.tags.join(' ')}`} href={`/blog/${post.slug}`}>
					<div class={`card-orbit ${post.accent}`}><span>{String(index + 1).padStart(2, '0')}</span><i></i></div>
					<div class="post-card-body"><div class="card-meta"><span>{category?.name}</span><time datetime={post.date.replaceAll('.', '-')}>{post.date}</time></div><h3>{post.title}</h3><p>{post.excerpt}</p><div class="card-bottom"><span>{post.tags.map((tag) => `#${tag}`).join('  ')}</span><span class="card-arrow">↗</span></div></div>
				</a>;
			})}
		</div>
		<p class="empty-state" id="empty-state" hidden>이 좌표에는 아직 기록이 없습니다.</p>
	</section>
</BaseLayout>

<script lang="ts">
	const search = document.querySelector<HTMLInputElement>('#post-search');
	const cards = [...document.querySelectorAll<HTMLElement>('[data-post-card]')];
	const emptyState = document.querySelector<HTMLElement>('#empty-state');
	const activeLabel = document.querySelector<HTMLElement>('#active-label');
	const total = document.querySelector<HTMLElement>('.active-filter span:last-child');
	const categorySwitcher = document.querySelector<HTMLElement>('.category-switcher');
	let categoryLinks = [...document.querySelectorAll<HTMLAnchorElement>('.category-switcher [data-category]')];
	const params = new URLSearchParams(window.location.search);
	const initialCategory = params.get('category') || 'all';
	const initialTag = params.get('tag') || '';
	let categoryLabels = Object.fromEntries(categoryLinks.map((link) => [link.dataset.category, link.textContent?.replace(/^\d+/, '').trim() || 'all transmissions']));
	function renderCategories(serverCategories) {
		if (!categorySwitcher) return;
		categorySwitcher.replaceChildren();
		const allLink = document.createElement('a');
		allLink.href = '/blog/';
		allLink.dataset.category = 'all';
		allLink.innerHTML = '<span>00</span>전체 기록';
		categorySwitcher.append(allLink);
		serverCategories.forEach((serverCategory, index) => {
			const link = document.createElement('a');
			link.className = serverCategory.accent || 'violet';
			link.href = `/blog/?category=${encodeURIComponent(serverCategory.slug)}`;
			link.dataset.category = serverCategory.slug;
			link.innerHTML = `<span>0${index + 1}</span>${serverCategory.name}`;
			categorySwitcher.append(link);
		});
		categoryLinks = [...categorySwitcher.querySelectorAll<HTMLAnchorElement>('[data-category]')];
		categoryLabels = Object.fromEntries(categoryLinks.map((link) => [link.dataset.category, link.textContent?.replace(/^\d+/, '').trim() || 'all transmissions']));
		filterPosts();
	}

	function filterPosts() {
		const query = search?.value.trim().toLowerCase() || '';
		let visible = 0;
		categoryLinks.forEach((link) => link.classList.toggle('active', !initialTag && link.dataset.category === initialCategory));
		cards.forEach((card) => {
			const matchesCategory = initialCategory === 'all' || card.dataset.category === initialCategory;
			const matchesTag = !initialTag || card.dataset.search?.includes(initialTag);
			const matchesQuery = !query || card.dataset.search?.toLowerCase().includes(query);
			const show = matchesCategory && matchesTag && matchesQuery;
			card.toggleAttribute('hidden', !show);
			card.classList.add('is-ready');
			if (show) visible += 1;
		});
		if (emptyState) emptyState.hidden = visible > 0;
		if (activeLabel) activeLabel.textContent = initialTag ? `#${initialTag}` : categoryLabels[initialCategory] || 'all transmissions';
		if (total) total.textContent = `${visible} visible`;
	}

	search?.addEventListener('input', filterPosts);
	filterPosts();
	void fetch('/api/categories').then(async (response) => {
		if (!response.ok) return;
		const data = await response.json();
		renderCategories(data.categories);
	}).catch(() => undefined);
</script>

<style>
	.archive-hero { display:flex; justify-content:space-between; align-items:end; gap:30px; padding:92px 0 76px; }.eyebrow { margin:0 0 22px; color:var(--muted); font:.65rem 'DM Mono',monospace; letter-spacing:.1em; text-transform:uppercase; }.eyebrow span { margin-right:13px; color:var(--cyan); }.archive-hero h1 { margin:0; font-size:clamp(2.7rem,6vw,5.5rem); line-height:.97; letter-spacing:-.07em; font-weight:500; }.archive-hero h1 em { color:var(--violet); font-style:normal; }.archive-intro { margin:28px 0 0; color:var(--muted); line-height:1.75; }.archive-count { display:flex; align-items:end; gap:12px; color:var(--muted); font:.62rem 'DM Mono',monospace; line-height:1.5; text-transform:uppercase; letter-spacing:.08em; }.archive-count strong { color:var(--cyan); font:4.8rem 'Space Grotesk',sans-serif; font-weight:400; line-height:.8; letter-spacing:-.08em; }.archive { padding-bottom:95px; }.archive-toolbar { display:flex; justify-content:space-between; align-items:end; gap:20px; padding-bottom:24px; border-bottom:1px solid var(--line); }.archive-toolbar h2 { margin:0; font-size:2rem; font-weight:500; letter-spacing:-.05em; }.search-box { display:flex; align-items:center; gap:10px; width:220px; padding:10px 0; color:var(--cyan); border-bottom:1px solid var(--line); }.search-box input { width:100%; border:0; outline:0; color:var(--ink); background:transparent; font: .78rem 'Space Grotesk',sans-serif; }.search-box input::placeholder { color:var(--faint); }.category-switcher { display:flex; flex-wrap:wrap; gap:10px; padding:25px 0 18px; }.category-switcher a { display:inline-flex; align-items:center; gap:10px; padding:12px 16px; color:var(--muted); border:1px solid var(--line); border-radius:999px; font:.72rem 'DM Mono',monospace; transition:background .2s,border-color .2s,color .2s,transform .2s; }.category-switcher a span { color:var(--cyan); font-size:.6rem; }.category-switcher a:hover,.category-switcher a.active { color:var(--ink); border-color:var(--cyan); background:rgba(98,220,232,.1); transform:translateY(-2px); }.category-switcher a.violet.active { border-color:var(--violet); background:rgba(167,155,255,.12); }.category-switcher a.amber.active { border-color:var(--amber); background:rgba(239,187,117,.12); }.active-filter { display:flex; align-items:center; gap:9px; margin:10px 0 24px; color:var(--faint); font:.6rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.08em; }.filter-dot { width:6px; height:6px; border-radius:50%; background:var(--cyan); box-shadow:0 0 10px var(--cyan); }.filter-rule { height:1px; flex:1; background:var(--line); }.post-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }.post-card { display:grid; grid-template-columns:88px 1fr; gap:22px; min-height:250px; padding:24px; border:1px solid var(--line); background:rgba(18,22,47,.7); transition:border-color .25s,transform .25s,background .25s; }.post-card:hover { border-color:rgba(98,220,232,.58); background:rgba(24,31,61,.9); transform:translateY(-3px); }.post-card[hidden] { display:none; }.card-orbit { position:relative; display:grid; place-items:center; align-self:start; aspect-ratio:1; border:1px solid rgba(167,155,255,.45); border-radius:50%; transform:rotate(-24deg) scaleY(.72); }.card-orbit::before { content:''; position:absolute; inset:13px -9px; border:1px solid rgba(98,220,232,.35); border-radius:50%; transform:rotate(58deg); }.card-orbit i { position:absolute; top:9px; right:8px; width:6px; height:6px; border-radius:50%; background:var(--amber); box-shadow:0 0 10px var(--amber); }.card-orbit span { color:var(--cyan); font:.7rem 'DM Mono',monospace; transform:rotate(24deg) scaleY(1.4); }.card-orbit.cyan { border-color:rgba(98,220,232,.5); }.card-orbit.amber { border-color:rgba(239,187,117,.5); }.post-card-body { display:flex; min-width:0; flex-direction:column; }.card-meta { display:flex; justify-content:space-between; gap:10px; color:var(--muted); font:.6rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.06em; }.post-card h3 { margin:35px 0 10px; font-size:1.25rem; line-height:1.2; font-weight:500; letter-spacing:-.04em; }.post-card p { margin:0; color:var(--muted); font-size:.86rem; line-height:1.65; }.card-bottom { display:flex; justify-content:space-between; gap:15px; align-items:end; margin-top:auto; padding-top:24px; color:var(--faint); font:.6rem 'DM Mono',monospace; }.card-arrow { color:var(--cyan); font-size:1.25rem; }.empty-state { margin:35px 0; color:var(--muted); text-align:center; font:.85rem 'DM Mono',monospace; }.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
	@media(max-width:700px) { .archive-hero { align-items:start; flex-direction:column; padding:65px 0 55px; }.archive-count { align-self:end; }.post-grid { grid-template-columns:1fr; }.post-card { min-height:220px; } }
	@media(max-width:500px) { .archive-toolbar { align-items:start; flex-direction:column; }.search-box { width:100%; }.category-switcher a { padding:10px 12px; }.post-card { grid-template-columns:64px 1fr; gap:16px; padding:18px; }.post-card h3 { margin-top:25px; font-size:1.08rem; }.card-meta { flex-direction:column; gap:4px; } }
</style>

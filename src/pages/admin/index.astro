---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, posts } from '../../data/posts';

const seedPosts = posts.map((post) => ({
	slug: post.slug,
	title: post.title,
	excerpt: post.excerpt,
	category: post.category,
	date: post.date,
	content: post.content.join('\n\n'),
}));
const editSlug = Astro.url.searchParams.get('edit');
---

<BaseLayout title="ADMIN / WRITE / ORBITAL NOTES" description="Orbital Notes 글 작성 공간.">
	<section class="admin-hero shell">
		<div>
			<p class="eyebrow"><span>04</span> authoring console</p>
			<h1>다음 기록을<br /><em>궤도에 올립니다.</em></h1>
		</div>
		<div class="draft-status" id="draft-status"><span class="status-dot"></span>local draft ready</div>
	</section>

	<section class="auth-gate shell" id="auth-gate" aria-labelledby="auth-heading">
		<div class="auth-copy"><p class="eyebrow"><span>LOCKED</span> private authoring space</p><h2 id="auth-heading">패스워드를 입력하면<br /><em>기록을 이어갈 수 있습니다.</em></h2></div>
		<form class="auth-form" id="login-form"><label class="field"><span class="field-label">ACCESS PASSWORD</span><input id="login-password" type="password" autocomplete="current-password" required /></label><button class="button primary" type="submit">unlock ↗</button><p class="auth-error" id="auth-error" role="alert" hidden>패스워드가 올바르지 않습니다.</p></form>
	</section>

	<nav class="admin-nav shell requires-auth" id="admin-nav" aria-label="관리자 메뉴" hidden><button class="admin-tab active" type="button" data-admin-view="write">write <span>새 글</span></button><button class="admin-tab" type="button" data-admin-view="posts">posts <span id="post-count">0</span></button></nav>

	<section class="editor-shell shell requires-auth" id="editor-shell" aria-label="글 작성 편집기" hidden>
		<form class="editor-form" id="editor-form">
			<div class="editor-toolbar">
				<div><span class="field-label">EDITING SIGNAL</span></div>
				<div class="toolbar-actions"><button class="button secondary" id="save-draft" type="button">상태 저장</button><button class="button secondary" id="publish-preview" type="button">미리보기</button><button class="button secondary" id="restore-revision" type="button">revision 복원</button><button class="button primary" id="publish-post" type="button">글 작성하기 ↗</button></div>
			</div>

			<div class="metadata-grid">
				<label class="field field-title"><span class="field-label">TITLE</span><input id="title" name="title" type="text" placeholder="기록의 제목을 입력하세요" required /></label>
				<div class="field category-field"><span class="field-label">CATEGORY</span><div class="category-control"><select id="category" name="category" required>{categories.map((category) => <option value={category.slug}>{category.name}</option>)}</select><button class="add-category" id="show-category-form" type="button" aria-label="카테고리 추가">+ add</button><button class="add-category" id="edit-category" type="button" aria-label="카테고리 수정">edit</button><button class="add-category" id="delete-category" type="button" aria-label="카테고리 삭제">delete</button></div><div class="category-form" id="category-form" hidden><input id="new-category" type="text" placeholder="새 카테고리 이름" /><button class="add-category confirm" id="add-category" type="button">추가</button></div></div>
				<label class="field"><span class="field-label">SLUG</span><input id="slug" name="slug" type="text" placeholder="post-slug" required /></label>
				<label class="field field-excerpt"><span class="field-label">EXCERPT</span><input id="excerpt" name="excerpt" type="text" placeholder="목록에 표시될 짧은 설명" /></label>
				<label class="field"><span class="field-label">STATUS</span><select id="post-status"><option value="draft">draft</option><option value="published">published</option><option value="unpublished">unpublished</option><option value="scheduled">scheduled</option></select></label>
				<label class="field"><span class="field-label">SCHEDULED AT</span><input id="scheduled-at" type="datetime-local" /></label>
				<label class="field"><span class="field-label">TAGS</span><input id="tags" type="text" placeholder="design, notes" /></label>
				<label class="field"><span class="field-label">COVER IMAGE</span><input id="cover-url" type="url" placeholder="/media/image.webp" /></label>
				<label class="field"><span class="field-label">SOCIAL TITLE</span><input id="social-title" type="text" /></label>
				<label class="field field-excerpt"><span class="field-label">SOCIAL DESCRIPTION</span><input id="social-description" type="text" /></label>
				<label class="field field-excerpt"><span class="field-label">MEDIA UPLOAD</span><input id="media-upload" type="file" accept="image/jpeg,image/png,image/webp,image/gif" /><button class="add-category" id="upload-media" type="button">upload / insert</button></label>
			</div>

			<div class="writing-grid">
				<label class="markdown-pane"><span class="pane-heading"><span>MARKDOWN</span><small>write freely</small></span><textarea id="content" name="content" spellcheck="false" placeholder="# 오늘의 기록\n\n생각을 Markdown으로 작성해보세요.\n\n- 목록\n- **강조**\n- `코드`"></textarea></label>
				<section class="preview-pane" aria-label="Markdown 미리보기"><div class="pane-heading"><span>RENDERED PREVIEW</span><small>live signal</small></div><article class="markdown-preview" id="preview"></article></section>
			</div>
		</form>
	</section>

	<section class="posts-shell shell requires-auth" id="posts-shell" aria-labelledby="posts-heading" hidden>
		<div class="posts-heading"><div><p class="eyebrow"><span>05</span> content registry</p><h2 id="posts-heading">작성한 글</h2><p class="posts-lede">작성한 기록의 상태를 확인하고 다음 궤도로 옮깁니다.</p></div><div class="posts-heading-actions"><p class="posts-caption">drafts and published signals</p><button class="new-post-button" type="button" data-admin-view="write"><span>+</span> 새 기록</button></div></div>
		<div class="posts-overview" aria-label="게시글 현황"><div><span class="overview-label">TOTAL NOTES</span><strong id="total-post-count">00</strong></div><div><span class="overview-label">PUBLISHED</span><strong id="published-post-count">00</strong></div><div><span class="overview-label">DRAFTS</span><strong id="draft-post-count">00</strong></div><div class="overview-signal"><span class="status-dot active"></span><span>registry synced</span></div></div>
		<div class="registry-toolbar"><label class="registry-search"><span>⌕</span><span class="sr-only">글 검색</span><input id="managed-post-search" type="search" placeholder="제목, slug, 설명 검색" autocomplete="off" /></label><label class="registry-filter"><span class="field-label">VIEW</span><select id="managed-post-filter"><option value="all">all notes</option><option value="published">published</option><option value="draft">drafts</option><option value="scheduled">scheduled</option><option value="unpublished">unpublished</option></select></label></div>
		<div class="post-manager-list" id="post-manager-list"></div>
	</section>

	<script type="application/json" id="seed-posts" set:html={JSON.stringify(seedPosts)}></script>
	<div id="editor-config" data-edit-slug={editSlug ?? ''}></div>
</BaseLayout>

<script>
	import { marked } from 'marked';
	import DOMPurify from 'dompurify';

	type SeedPost = { slug: string; title: string; excerpt: string; category: string; date: string; content: string };
	type EditablePost = Omit<SeedPost, 'date'> & { status: string; scheduledAt: string; tags: string[]; coverUrl: string; socialTitle: string; socialDescription: string };
	type DraftPost = EditablePost;
	type LocalCategory = { name: string; slug: string };
	type ApiPost = { id: number; slug: string; title: string; excerpt: string; category_slug: string; body: string; status: string; updated_at: string; scheduled_at: string | null; tags: string[]; cover_url: string | null; social_title: string | null; social_description: string | null };

	const seedScript = document.querySelector<HTMLScriptElement>('#seed-posts');
	const seedPosts: EditablePost[] = (JSON.parse(seedScript?.textContent || '[]') as SeedPost[]).map((post) => ({ ...post, status: 'published', scheduledAt: '', tags: [], coverUrl: '', socialTitle: '', socialDescription: '' }));
	let serverPosts: EditablePost[] = [];
	let managedPosts: ApiPost[] = [];
	let loadedServerSlug: string | null = null;
	const draftKey = 'orbital-notes-drafts';
	const form = document.querySelector<HTMLFormElement>('#editor-form');
	const editSlug = document.querySelector<HTMLElement>('#editor-config')?.dataset.editSlug || '';
	const authGate = document.querySelector<HTMLElement>('#auth-gate');
	const editorShell = document.querySelector<HTMLElement>('#editor-shell');
	const postsShell = document.querySelector<HTMLElement>('#posts-shell');
	const adminNav = document.querySelector<HTMLElement>('#admin-nav');
	const loginForm = document.querySelector<HTMLFormElement>('#login-form');
	const loginPassword = document.querySelector<HTMLInputElement>('#login-password');
	const authError = document.querySelector<HTMLElement>('#auth-error');
	const title = document.querySelector<HTMLInputElement>('#title');
	const category = document.querySelector<HTMLSelectElement>('#category');
	const slug = document.querySelector<HTMLInputElement>('#slug');
	const excerpt = document.querySelector<HTMLInputElement>('#excerpt');
	const content = document.querySelector<HTMLTextAreaElement>('#content');
	const postStatus = document.querySelector<HTMLSelectElement>('#post-status');
	const scheduledAt = document.querySelector<HTMLInputElement>('#scheduled-at');
	const tags = document.querySelector<HTMLInputElement>('#tags');
	const coverUrl = document.querySelector<HTMLInputElement>('#cover-url');
	const socialTitle = document.querySelector<HTMLInputElement>('#social-title');
	const socialDescription = document.querySelector<HTMLInputElement>('#social-description');
	const preview = document.querySelector<HTMLElement>('#preview');
	const status = document.querySelector<HTMLElement>('#draft-status');
	const saveDraft = document.querySelector<HTMLButtonElement>('#save-draft');
	const publishPreview = document.querySelector<HTMLButtonElement>('#publish-preview');
	const publishPost = document.querySelector<HTMLButtonElement>('#publish-post');
	const restoreRevision = document.querySelector<HTMLButtonElement>('#restore-revision');
	const mediaUpload = document.querySelector<HTMLInputElement>('#media-upload');
	const uploadMedia = document.querySelector<HTMLButtonElement>('#upload-media');
	const categoryForm = document.querySelector<HTMLDivElement>('#category-form');
	const showCategoryForm = document.querySelector<HTMLButtonElement>('#show-category-form');
	const newCategory = document.querySelector<HTMLInputElement>('#new-category');
	const addCategory = document.querySelector<HTMLButtonElement>('#add-category');
	const editCategory = document.querySelector<HTMLButtonElement>('#edit-category');
	const deleteCategory = document.querySelector<HTMLButtonElement>('#delete-category');
	const postManagerList = document.querySelector<HTMLElement>('#post-manager-list');
	const postCount = document.querySelector<HTMLElement>('#post-count');
	const totalPostCount = document.querySelector<HTMLElement>('#total-post-count');
	const publishedPostCount = document.querySelector<HTMLElement>('#published-post-count');
	const draftPostCount = document.querySelector<HTMLElement>('#draft-post-count');
	const managedPostSearch = document.querySelector<HTMLInputElement>('#managed-post-search');
	const managedPostFilter = document.querySelector<HTMLSelectElement>('#managed-post-filter');
	const adminTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-admin-view]')];
	let autosaveTimer: number | undefined;

	const getDrafts = (): Record<string, DraftPost> => JSON.parse(localStorage.getItem(draftKey) || '{}');
	const getCsrfToken = () => document.cookie.split('; ').find((cookie) => cookie.startsWith('blog_csrf='))?.split('=')[1] || '';
	const categoryKey = 'orbital-notes-categories';
	const getLocalCategories = (): LocalCategory[] => JSON.parse(localStorage.getItem(categoryKey) || '[]');
	const setStatus = (message: string, active = false) => {
		if (status) status.innerHTML = `<span class="status-dot${active ? ' active' : ''}"></span>${message}`;
	};
	const currentPost = (): DraftPost => ({ slug: slug?.value.trim() || '', title: title?.value.trim() || '', excerpt: excerpt?.value.trim() || '', category: category?.value || '', content: content?.value || '', status: postStatus?.value || 'draft', scheduledAt: scheduledAt?.value || '', tags: (tags?.value || '').split(',').map((tag) => tag.trim()).filter(Boolean), coverUrl: coverUrl?.value.trim() || '', socialTitle: socialTitle?.value.trim() || '', socialDescription: socialDescription?.value.trim() || '' });
	const findPost = (postSlug: string) => (serverPosts.length ? serverPosts : seedPosts).find((post) => post.slug === postSlug);

	function switchAdminView(view: string) {
		const showPosts = view === 'posts';
		if (editorShell) editorShell.hidden = showPosts;
		if (postsShell) postsShell.hidden = !showPosts;
		adminTabs.forEach((tab) => tab.classList.toggle('active', tab.dataset.adminView === view));
	}

	function renderPostManager() {
		if (!postManagerList) return;
		postManagerList.replaceChildren();
		const query = managedPostSearch?.value.trim().toLowerCase() || '';
		const selectedStatus = managedPostFilter?.value || 'all';
		const visiblePosts = managedPosts.filter((post) => {
			const matchesStatus = selectedStatus === 'all' || post.status === selectedStatus;
			const searchable = `${post.title} ${post.slug} ${post.excerpt} ${post.category_slug}`.toLowerCase();
			return matchesStatus && (!query || searchable.includes(query));
		});
		if (postCount) postCount.textContent = String(managedPosts.length).padStart(2, '0');
		if (totalPostCount) totalPostCount.textContent = String(managedPosts.length).padStart(2, '0');
		if (publishedPostCount) publishedPostCount.textContent = String(managedPosts.filter((post) => post.status === 'published').length).padStart(2, '0');
		if (draftPostCount) draftPostCount.textContent = String(managedPosts.filter((post) => post.status === 'draft').length).padStart(2, '0');
		if (!visiblePosts.length) {
			const empty = document.createElement('p');
			empty.className = 'posts-empty';
			empty.textContent = managedPosts.length ? '현재 필터에 맞는 기록이 없습니다.' : '아직 저장된 글이 없습니다.';
			postManagerList.append(empty);
			return;
		}
		const escapeHtml = (value: string) => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
		visiblePosts.forEach((post, index) => {
			const item = document.createElement('article');
			item.className = 'managed-post';
			const safeTitle = escapeHtml(post.title);
			const safeExcerpt = escapeHtml(post.excerpt || '설명이 없습니다.');
			const safeCategory = escapeHtml(post.category_slug);
			const safeSlug = escapeHtml(post.slug);
			item.innerHTML = `<span class="managed-index">${String(index + 1).padStart(2, '0')}</span><div class="managed-main"><div class="managed-meta"><span class="status-pill ${escapeHtml(post.status)}">${escapeHtml(post.status)}</span><span class="managed-category">${safeCategory}</span><span class="managed-updated">updated ${escapeHtml(post.updated_at.slice(0, 10))}</span></div><h3>${safeTitle}</h3><p>${safeExcerpt}</p><span class="managed-slug">/${safeSlug}</span></div><div class="managed-actions"><a class="managed-edit" href="/admin/?edit=${encodeURIComponent(post.slug)}"><span>↗</span> 편집</a><button class="managed-delete" type="button" data-delete-slug="${safeSlug}"><span>×</span> 삭제</button></div>`;
			postManagerList.append(item);
		});
	}

	function renderPreview() {
		const rendered = marked.parse(content?.value || '*작성 중인 Markdown이 여기에 나타납니다.*');
		if (preview) preview.innerHTML = DOMPurify.sanitize(typeof rendered === 'string' ? rendered : '');
	}

	function loadPost(postSlug: string) {
		const source = postSlug === 'new' ? { slug: '', title: '', excerpt: '', category: category?.options[0]?.value || '', content: '', status: 'draft', scheduledAt: '', tags: [], coverUrl: '', socialTitle: '', socialDescription: '' } : findPost(postSlug);
		const saved = postSlug === 'new' ? null : getDrafts()[postSlug];
		const next = saved || source;
		if (!next) return;
		loadedServerSlug = postSlug === 'new' ? null : postSlug;
		if (title) title.value = next.title || '';
		if (excerpt) excerpt.value = next.excerpt || '';
		if (category) category.value = next.category || category.options[0]?.value || '';
		if (slug) slug.value = next.slug || '';
		if (content) content.value = next.content || '';
		if (postStatus) postStatus.value = next.status || 'draft';
		if (scheduledAt) scheduledAt.value = next.scheduledAt || '';
		if (tags) tags.value = next.tags?.join(', ') || '';
		if (coverUrl) coverUrl.value = next.coverUrl || '';
		if (socialTitle) socialTitle.value = next.socialTitle || '';
		if (socialDescription) socialDescription.value = next.socialDescription || '';
		renderPreview();
		setStatus(saved ? 'local draft restored' : 'local draft ready', Boolean(saved));
	}

	async function loadServerData() {
		const [postsResponse, categoriesResponse] = await Promise.all([
			fetch('/api/posts?includeDrafts=true', { credentials: 'include' }),
			fetch('/api/categories', { credentials: 'include' }),
		]);
		if (!postsResponse.ok || !categoriesResponse.ok) throw new Error('server_data_unavailable');
		const postData = await postsResponse.json() as { posts: ApiPost[] };
		const categoryData = await categoriesResponse.json() as { categories: LocalCategory[] };
		managedPosts = postData.posts;
		serverPosts = managedPosts.map((post) => ({ slug: post.slug, title: post.title, excerpt: post.excerpt, category: post.category_slug, date: '', content: post.body, status: post.status, scheduledAt: post.scheduled_at || '', tags: post.tags, coverUrl: post.cover_url || '', socialTitle: post.social_title || '', socialDescription: post.social_description || '' }));
		if (category) {
			category.replaceChildren(...categoryData.categories.map((item) => new Option(item.name, item.slug)));
		}
		loadPost(editSlug || 'new');
		renderPostManager();
	}

	async function refreshPostManager() {
		const response = await fetch('/api/posts?includeDrafts=true', { credentials: 'include' });
		if (!response.ok) throw new Error('post_list_unavailable');
		const data = await response.json() as { posts: ApiPost[] };
		managedPosts = data.posts;
		renderPostManager();
	}

	function unlockEditor() {
		if (authGate) authGate.hidden = true;
		if (editorShell) editorShell.hidden = false;
		if (adminNav) adminNav.hidden = false;
	}

	async function persistPost(status: string) {
		const post = currentPost();
		post.status = status;
		const drafts = getDrafts();
		drafts[post.slug || 'new'] = post;
		localStorage.setItem(draftKey, JSON.stringify(drafts));
		const method = loadedServerSlug ? 'PUT' : 'POST';
		const endpoint = loadedServerSlug ? `/api/posts/${encodeURIComponent(loadedServerSlug)}` : '/api/posts';
		const response = await fetch(endpoint, { method, credentials: 'include', headers: { 'content-type': 'application/json', 'x-csrf-token': getCsrfToken() }, body: JSON.stringify({ title: post.title, slug: post.slug, excerpt: post.excerpt, body: post.content, category: post.category, tags: post.tags, status, scheduledAt: post.scheduledAt ? new Date(post.scheduledAt).toISOString() : null, coverUrl: post.coverUrl || null, socialTitle: post.socialTitle || null, socialDescription: post.socialDescription || null }) });
		if (!response.ok) throw new Error('post_save_failed');
		loadedServerSlug = post.slug;
		await refreshPostManager();
		setStatus(status === 'published' ? 'published to server' : `saved draft / ${new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit' })}`, true);
	}

	async function addLocalCategory() {
		const name = newCategory?.value.trim();
		if (!name) return;
		const nextCategory = { name, slug: `category-${Date.now()}` };
		const response = await fetch('/api/categories', { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json', 'x-csrf-token': getCsrfToken() }, body: JSON.stringify(nextCategory) });
		if (!response.ok) {
			setStatus('category could not be saved', true);
			return;
		}
		const option = new Option(nextCategory.name, nextCategory.slug, true, true);
		category?.add(option);
		if (newCategory) newCategory.value = '';
		if (categoryForm) categoryForm.hidden = true;
		setStatus(`category added / ${name}`, true);
	}

	async function editSelectedCategory() {
		const currentSlug = category?.value;
		if (!currentSlug) return;
		const name = window.prompt('새 카테고리 이름', category?.selectedOptions[0]?.textContent ?? '');
		if (!name?.trim()) return;
		const response = await fetch(`/api/categories/${encodeURIComponent(currentSlug)}`, { method: 'PUT', credentials: 'include', headers: { 'content-type': 'application/json', 'x-csrf-token': getCsrfToken() }, body: JSON.stringify({ name: name.trim(), slug: currentSlug, accent: 'violet' }) });
		if (!response.ok) throw new Error('category_update_failed');
		await loadServerData();
		setStatus('category updated', true);
	}

	async function deleteSelectedCategory() {
		const currentSlug = category?.value;
		if (!currentSlug || !window.confirm('선택한 카테고리를 삭제할까요?')) return;
		const response = await fetch(`/api/categories/${encodeURIComponent(currentSlug)}`, { method: 'DELETE', credentials: 'include', headers: { 'content-type': 'application/json', 'x-csrf-token': getCsrfToken() } });
		if (!response.ok) throw new Error('category_delete_failed');
		await loadServerData();
		setStatus('category deleted', true);
	}

	async function restoreSelectedRevision() {
		if (!loadedServerSlug) return setStatus('save the post before restoring a revision', true);
		const response = await fetch(`/api/posts/${encodeURIComponent(loadedServerSlug)}/revisions`, { credentials: 'include' });
		if (!response.ok) throw new Error('revision_list_failed');
		const data = await response.json() as { revisions: { id: number; createdAt: string }[] };
		if (!data.revisions.length) return setStatus('no revisions yet', true);
		const revisionId = window.prompt(`복원할 revision ID를 입력하세요: ${data.revisions.map((revision) => `${revision.id} (${revision.createdAt})`).join(', ')}`);
		if (!revisionId || !window.confirm('선택한 revision으로 복원할까요?')) return;
		const restoreResponse = await fetch(`/api/posts/${encodeURIComponent(loadedServerSlug)}/revisions`, { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json', 'x-csrf-token': getCsrfToken() }, body: JSON.stringify({ revisionId: Number(revisionId) }) });
		if (!restoreResponse.ok) throw new Error('revision_restore_failed');
		await loadServerData();
		setStatus('revision restored', true);
	}

	async function uploadSelectedMedia() {
		const file = mediaUpload?.files?.[0];
		if (!file) return;
		const formData = new FormData();
		formData.append('file', file);
		const response = await fetch('/api/media', { method: 'POST', credentials: 'include', headers: { 'x-csrf-token': getCsrfToken() }, body: formData });
		if (!response.ok) throw new Error('media_upload_failed');
		const data = await response.json() as { url: string };
		if (coverUrl) coverUrl.value = data.url;
		if (content) content.value += `${content.value ? '\n\n' : ''}![${file.name}](${data.url})`;
		renderPreview();
		setStatus('media uploaded and inserted', true);
	}

	getLocalCategories().forEach((localCategory: LocalCategory) => category?.add(new Option(localCategory.name, localCategory.slug)));

	[title, category, slug, excerpt, content, postStatus, scheduledAt, tags, coverUrl, socialTitle, socialDescription].forEach((field) => field?.addEventListener('input', () => {
		renderPreview();
		const post = currentPost();
		if (post.slug || post.title || post.content) localStorage.setItem(draftKey, JSON.stringify({ ...getDrafts(), [post.slug || 'new']: post }));
		setStatus('unsaved changes', true);
		window.clearTimeout(autosaveTimer);
		if (post.title && post.slug && post.category) autosaveTimer = window.setTimeout(() => void persistPost(post.status || 'draft').catch(() => setStatus('autosave failed', true)), 1200);
	}));
	showCategoryForm?.addEventListener('click', () => {
		if (!categoryForm) return;
		categoryForm.hidden = !categoryForm.hidden;
		if (!categoryForm.hidden) newCategory?.focus();
	});
	addCategory?.addEventListener('click', () => void addLocalCategory());
	editCategory?.addEventListener('click', () => void editSelectedCategory().catch(() => setStatus('category update failed', true)));
	deleteCategory?.addEventListener('click', () => void deleteSelectedCategory().catch(() => setStatus('category delete failed', true)));
	restoreRevision?.addEventListener('click', () => void restoreSelectedRevision().catch(() => setStatus('revision restore failed', true)));
	uploadMedia?.addEventListener('click', () => void uploadSelectedMedia().catch(() => setStatus('media upload failed', true)));
	newCategory?.addEventListener('keydown', (event: KeyboardEvent) => {
		if (event.key === 'Enter') void addLocalCategory();
	});
	saveDraft?.addEventListener('click', () => void persistPost(postStatus?.value || 'draft').catch(() => setStatus('server save failed', true)));
	publishPreview?.addEventListener('click', () => {
		preview?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
	publishPost?.addEventListener('click', () => void persistPost('published').then(() => window.location.assign('/')).catch(() => setStatus('server publish failed', true)));
	form?.addEventListener('submit', (event) => event.preventDefault());
	adminTabs.forEach((tab) => tab.addEventListener('click', () => switchAdminView(tab.dataset.adminView || 'write')));
	managedPostSearch?.addEventListener('input', renderPostManager);
	managedPostFilter?.addEventListener('change', renderPostManager);
	async function deletePost(postSlug: string) {
		const response = await fetch(`/api/posts/${encodeURIComponent(postSlug)}`, { method: 'DELETE', credentials: 'include', headers: { 'content-type': 'application/json', 'x-csrf-token': getCsrfToken() } });
		if (!response.ok) {
			const error = await response.json().catch(() => ({ error: 'delete_failed' }));
			throw new Error(error.error || 'delete_failed');
		}
		managedPosts = managedPosts.filter((post) => post.slug !== postSlug);
		renderPostManager();
		setStatus('post deleted', true);
	}
	postManagerList?.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;
		const deleteButton = target.closest<HTMLButtonElement>('[data-delete-slug]');
		if (!deleteButton) return;
		const postSlug = deleteButton.dataset.deleteSlug;
		if (!postSlug || !window.confirm('이 글을 삭제할까요?')) return;
		void deletePost(postSlug).catch((error: Error) => setStatus(`delete failed / ${error.message}`, true));
	});

	loginForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (authError) authError.hidden = true;
		const response = await fetch('/api/auth/login', { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ password: loginPassword?.value || '' }) });
		if (!response.ok) {
			if (authError) authError.hidden = false;
			return;
		}
		unlockEditor();
		try {
			await loadServerData();
		} catch {
			setStatus('server data unavailable', true);
		}
	});

	async function bootstrap() {
		const response = await fetch('/api/auth/me', { credentials: 'include' });
		if (!response.ok || !(await response.json()).authenticated) return;
		unlockEditor();
		try {
			await loadServerData();
		} catch {
			setStatus('server data unavailable', true);
		}
	}
	void bootstrap();
</script>


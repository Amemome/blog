---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="ADMIN / LOGIN / ORBITAL NOTES" description="Orbital Notes 관리자 로그인.">
	<section class="login-page shell" aria-labelledby="login-heading">
		<div>
			<p class="eyebrow"><span>LOCKED</span> private authoring space</p>
			<h1 id="login-heading">기록을 이어갈<br /><em>좌표를 확인합니다.</em></h1>
		</div>
		<form class="login-form" id="login-form">
			<label class="field"><span class="field-label">ACCESS PASSWORD</span><input id="password" type="password" autocomplete="current-password" required /></label>
			<button class="button primary" type="submit">unlock ↗</button>
			<p id="login-error" class="login-error" role="alert" hidden>로그인에 실패했습니다. 잠시 후 다시 시도하세요.</p>
		</form>
	</section>
</BaseLayout>

<script>
	const form = document.querySelector<HTMLFormElement>('#login-form');
	const password = document.querySelector<HTMLInputElement>('#password');
	const error = document.querySelector<HTMLElement>('#login-error');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (error) error.hidden = true;
		const response = await fetch('/api/auth/login', { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ password: password?.value ?? '' }) });
		if (!response.ok) {
			if (error) {
				error.textContent = response.status === 429 ? '로그인 시도가 너무 많습니다. 잠시 후 다시 시도하세요.' : '로그인에 실패했습니다. 잠시 후 다시 시도하세요.';
				error.hidden = false;
			}
			return;
		}
		window.location.assign('/admin/');
	});
</script>

<style>
	.login-page { display:grid; grid-template-columns:1fr .65fr; gap:80px; align-items:end; padding:120px 0 170px; }.eyebrow { margin:0 0 22px; color:var(--muted); font:.65rem 'DM Mono',monospace; letter-spacing:.1em; text-transform:uppercase; }.eyebrow span { margin-right:13px; color:var(--cyan); }.login-page h1 { margin:0; font-size:clamp(2.7rem,6vw,5.4rem); line-height:.96; letter-spacing:-.07em; font-weight:500; }.login-page h1 em { color:var(--violet); font-style:normal; }.login-form { display:flex; align-items:end; gap:14px; }.field { display:flex; flex:1; flex-direction:column; gap:10px; min-width:0; }.field-label { color:var(--faint); font:.58rem 'DM Mono',monospace; letter-spacing:.1em; }.field input { width:100%; padding:11px 0; color:var(--ink); border:0; border-bottom:1px solid var(--line); outline:0; background:transparent; font:.9rem 'Space Grotesk',sans-serif; }.field input:focus { border-color:var(--cyan); }.button { padding:11px 15px; border:1px solid var(--line); border-radius:2px; color:var(--ink); font:.65rem 'DM Mono',monospace; cursor:pointer; }.button.primary { border-color:var(--cyan); background:rgba(98,220,232,.1); }.login-error { position:absolute; margin-top:75px; color:#ef8b9d; font:.68rem 'DM Mono',monospace; }
	@media(max-width:700px) { .login-page { grid-template-columns:1fr; gap:50px; padding:80px 0 120px; }.login-form { align-items:stretch; flex-direction:column; }.login-error { position:static; margin:0; } }
</style>

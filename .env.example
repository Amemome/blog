# Server
DATABASE_PATH=./data/blog.sqlite
MEDIA_DIR=./data/media
BACKUP_DIR=./data/backups
# Optional separate mount or synchronized directory for off-host copies.
# BACKUP_REMOTE_DIR=/mnt/backup-replica/blog
# Optional GPG recipient. When set, database and media backups are encrypted.
# BACKUP_GPG_RECIPIENT=ops@example.com
PUBLIC_SITE_URL=http://localhost:4321

# Admin login: password only (use ADMIN_PASSWORD_HASH in production when possible)
ADMIN_PASSWORD=change-this-before-running
# Generate a hash with: node -e "const c=require('node:crypto');const s=c.randomBytes(16).toString('hex');console.log(s+'$'+c.scryptSync('your-password',s,64).toString('hex'))"
# ADMIN_PASSWORD_HASH=salt$derived-key
